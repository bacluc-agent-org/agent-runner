#!/usr/bin/env bash
set -Eeuo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# The .opencode tests import TypeScript directly and use node --test globs,
# which need Node >= 22. Prefer a newer Node when the default is too old
# (e.g. the Blacksmith runners ship Node 20).
if ! node --version | grep -qE '^v(2[2-9]|[3-9][0-9])\.'; then
  for node_dir in /opt/hostedtoolcache/node/*/x64/bin; do
    if "$node_dir/node" --version | grep -qE '^v(2[2-9]|[3-9][0-9])\.'; then
      export PATH="$node_dir:$PATH"
      break
    fi
  done
fi

# renovate: datasource=docker depName=ghcr.io/bacluc/prettier-image/prettier-image
PRETTIER_VERSION=5.1.1
# renovate: datasource=docker depName=rhysd/actionlint
ACTIONLINT_VERSION=1.7.12

mount=(-v "$PWD:/workspace" -w /workspace)
status=0

# The prettier check must not cover nested git checkouts in the workspace
# (e.g. cloned target repositories): they have their own formatting rules
# and toolchain. git lists such checkouts as a single untracked "<dir>/"
# entry, while regular untracked files of this repository stay checked.
prettier_ignore=".prettierignore.completion-check"
trap 'rm -f "$prettier_ignore"' EXIT
cat .gitignore .prettierignore 2> /dev/null > "$prettier_ignore" || true
printf '%s\n' "$prettier_ignore" >> "$prettier_ignore"
while IFS= read -r entry; do
  if [[ -e "${entry%/}/.git" ]]; then printf '%s\n' "${entry%/}/"; fi
done < <(git ls-files --others --exclude-standard) >> "$prettier_ignore"

check() {
  local name="$1"
  shift
  printf '==> %s\n' "$name"
  if "$@"; then
    printf 'PASS: %s\n' "$name"
  else
    printf 'FAIL: %s\n' "$name" >&2
    status=1
  fi
}

if command -v npx > /dev/null 2>&1; then
  check 'formatting (prettier --check .)' npx prettier --ignore-path "$prettier_ignore" --check .
else
  check 'formatting (prettier --check .)' bash -c 'npm install --quiet prettier && npx prettier --ignore-path "$prettier_ignore" --check .'
fi
check 'actionlint (workflows + used actions)' docker run --rm "${mount[@]}" "rhysd/actionlint:${ACTIONLINT_VERSION}" -color
# The running opencode session owns .opencode/node_modules and rewrites it while
# this script runs (observed: dist/index.js present, then gone seconds later), so
# npm ci there never leaves a tree the tool tests can import. Test a private copy.
opencode_check="${RUNNER_TEMP:-$(mktemp -d)}/opencode-completion-check"
rm -rf "$opencode_check"
mkdir -p "$opencode_check/node" "$opencode_check/tree"
cp .opencode/package.json .opencode/package-lock.json "$opencode_check/node/"
check 'opencode node dependencies (npm ci)' npm ci --prefix "$opencode_check/node"
tar -C .opencode --exclude=./node_modules -cf - . | tar -C "$opencode_check/tree" -xf -
ln -s ../node/node_modules "$opencode_check/tree/node_modules"
check 'opencode plugin tests (node --test)' node --test "$opencode_check/tree/plugin/*.test.mjs"
check 'opencode tool tests (node --test)' node --test "$opencode_check/tree/tool/*.test.mjs"
# The pytest suite (model-availability) reads ~/.local/share/opencode/auth.json
# via fetch_openai_oauth_model_ids; on a runner holding a real OpenAI OAuth
# login that fetches the live catalog and leaks unmocked models into tests.
# Run pytest with HOME isolated from the ambient opencode login.
pytest_home="${RUNNER_TEMP:-$(mktemp -d)}/pytest-home"
rm -rf "$pytest_home"
mkdir -p "$pytest_home"
if command -v uv > /dev/null 2>&1; then
  check 'pytest (scripts tests)' env HOME="$pytest_home" uv run --group dev python -m pytest -q
elif command -v pytest > /dev/null 2>&1; then
  check 'pytest (scripts tests)' env HOME="$pytest_home" pytest -q
else
  check 'pytest (scripts tests)' env HOME="$pytest_home" bash -c 'python3 -m pip install --quiet pytest && python3 -m pytest -q'
fi

if [ "$status" != "0" ]; then
  echo ""
  echo ""
  echo "CHECK FAILED"
  echo ""
  echo ""
fi

exit "$status"
