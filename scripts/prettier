#!/usr/bin/env bash
set -Eeuo pipefail

# Format this repository with the pinned prettier image.
#
# Usage: scripts/prettier [--check | --write]
#   --check  fail on formatting differences (default)
#   --write  rewrite files in place
#
# The image pin lives in scripts/completion-check (the single renovate source);
# this script reads it from there, so it works from any caller cwd.

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

mode="${1:---check}"
case "$mode" in
  --check | --write) ;;
  *)
    printf 'usage: %s [--check|--write]\n' "${0##*/}" >&2
    exit 2
    ;;
esac

# Single source of the version pin: parse the PRETTIER_VERSION assignment out
# of scripts/completion-check rather than duplicating it and its renovate
# comment.
PRETTIER_VERSION="$(sed -n 's/^PRETTIER_VERSION=//p' "$script_dir/completion-check")"
if [ -z "$PRETTIER_VERSION" ]; then
  printf 'error: could not read PRETTIER_VERSION from %s\n' "$script_dir/completion-check" >&2
  exit 1
fi

cd "$repo_root"

# The prettier check must not cover nested git checkouts in the workspace
# (e.g. cloned target repositories): they have their own formatting rules
# and toolchain. git lists such checkouts as a single untracked "<dir>/"
# entry, while regular untracked files of this repository stay checked.
prettier_ignore=".prettierignore.completion-check"
trap 'rm -f "$prettier_ignore"' EXIT
cat .gitignore .prettierignore 2> /dev/null > "$prettier_ignore" || true
printf '%s\n' "$prettier_ignore" >> "$prettier_ignore"
while IFS= read -r entry; do
  if [[ -e "${entry%/}/.git" ]]; then printf '%s\n' "${entry%/}/"; fi
done < <(git ls-files --others --exclude-standard) >> "$prettier_ignore"

docker run --rm -v "$PWD:/workspace" -w /workspace \
  "ghcr.io/bacluc/prettier-image/prettier-image:${PRETTIER_VERSION}" \
  --ignore-path "$prettier_ignore" "$mode" .
